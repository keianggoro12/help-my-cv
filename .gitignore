node_modules/
.next/
# Any alternate distDir Next is run with (`NEXT_DIST_DIR=.next-dev` for the dev
# server, `.next-ai` for a scratch build). One pattern instead of a list that
# has to grow every time a build is run with a new name.
.next-*/
out/
dist/
*.tsbuildinfo
.DS_Store
.env
.env*.local

# Wrangler's local state: the miniflare D1 database, the R2 filesystem and
# the observability trace store. These are per-machine copies of data that
# already exists in the real D1/R2, and they were being committed — which
# means every local migration and every local upload showed up as a binary
# diff in review.
.wrangler/

# Build outputs that Next/OpenNext write next to the source. They change on
# every build (hashed filenames), so tracking them turns each build into
# hundreds of fake diffs.
.open-next/
.next-fresh/
.next-test2/
