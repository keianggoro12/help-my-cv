{
  "name": "help-my-cv-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@helpmycv/frontend",
    "dev:backend": "npm run dev --workspace=@helpmycv/backend",
    "build": "npm run build --workspace=@helpmycv/frontend",
    "lint": "npm run lint --workspace=@helpmycv/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "packageManager": "npm@10.8.0"
}
