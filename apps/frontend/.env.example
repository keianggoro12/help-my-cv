# Local development with the real Hono backend (wrangler on :8788).
#
# Leave it unset to keep the phase-1 behaviour: mock auth and localStorage, so
# every flow stays clickable with no server running. Setting it switches the
# auth and resume stores to the API client.
#
# The backend itself is started with `npm run dev:backend` from the repo root.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8788